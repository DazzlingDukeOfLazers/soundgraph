{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soundgraph.dev/schema/board.schema.json",
  "title": "SoundGraph Board Profile",
  "description": "Describes one physical board: which processor target it uses and how audio and controls are wired. A board profile is data consumed by the generic firmware \u2014 it must never alter graph semantics. Target (esp32-s3) and board (this file) are deliberately separate: the target defines architecture and memory constraints, the board defines pins and peripherals.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "name",
    "target",
    "audio_out"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "description": "Stable identifier, used to select the profile at build time.",
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string"
    },
    "vendor": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "target": {
      "description": "Processor target the generic firmware is built for.",
      "type": "string",
      "enum": [
        "esp32-s3",
        "esp32-p4"
      ]
    },
    "notes": {
      "type": "string"
    },
    "audio_out": {
      "type": "object",
      "required": [
        "kind",
        "sample_rate"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "description": "i2s-dac: an external or onboard DAC driven over plain I2S with no control channel (PCM5102 and friends). codec: a chip that also needs I2C configuration.",
          "type": "string",
          "enum": [
            "i2s-dac",
            "codec"
          ]
        },
        "chip": {
          "type": "string"
        },
        "sample_rate": {
          "type": "integer",
          "enum": [
            32000,
            44100,
            48000
          ],
          "description": "32000 is here because a board earned it: the watch runs both its instruments only at 32 kHz, and on a fingernail speaker there is nothing above 16 kHz to lose. Nothing validates this file, so the enum is a claim about what the firmware is known to do rather than a gate."
        },
        "bits": {
          "type": "integer",
          "enum": [
            16,
            24,
            32
          ],
          "default": 16
        },
        "i2s": {
          "type": "object",
          "required": [
            "bclk",
            "ws",
            "dout"
          ],
          "additionalProperties": false,
          "properties": {
            "bclk": {
              "type": "integer"
            },
            "ws": {
              "type": "integer"
            },
            "dout": {
              "type": "integer"
            },
            "mclk": {
              "type": "integer",
              "description": "-1 or absent when the DAC needs no master clock."
            }
          }
        },
        "i2c": {
          "description": "Only for kind=codec.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sda": {
              "type": "integer"
            },
            "scl": {
              "type": "integer"
            },
            "address": {
              "type": "integer"
            }
          }
        },
        "amp": {
          "description": "The speaker power amplifier's enable line, when it has one. Smart-speaker boards often route it through an I2C I/O expander rather than a chip GPIO.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "gpio": {
              "type": "integer",
              "description": "Direct chip GPIO, when it is one."
            },
            "expander": {
              "type": "string",
              "description": "Expander chip, e.g. tca9555."
            },
            "i2c_address": {
              "type": "integer"
            },
            "pin": {
              "type": "integer",
              "description": "Expander pin number, e.g. 8 for EXIO08."
            }
          }
        }
      }
    },
    "audio_in": {
      "type": "object",
      "additionalProperties": true,
      "description": "Shape mirrors audio_out. Absent means the board has no audio input; AudioInput nodes then produce silence, exactly as in a browser without getUserMedia."
    },
    "psram": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "present": {
          "type": "boolean"
        },
        "mode": {
          "type": "string",
          "enum": [
            "quad",
            "octal"
          ]
        },
        "megabytes": {
          "type": "integer"
        }
      }
    },
    "controls": {
      "description": "Physical performance controls, for later mapping onto patch control surfaces.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "button",
              "encoder",
              "pot",
              "touch"
            ]
          },
          "pin": {
            "type": "integer"
          },
          "pin_b": {
            "type": "integer"
          }
        }
      }
    },
    "display": {
      "description": "The panel, when the board has one. Absent means no display, and the firmware compiles the whole UI out rather than carrying a driver for hardware that is not there.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "chip",
        "width",
        "height"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "qspi"
          ],
          "description": "How the panel is wired. Only quad SPI so far."
        },
        "chip": {
          "type": "string",
          "description": "Driver IC, e.g. CO5300."
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "x_offset": {
          "type": "integer",
          "description": "Column offset into the driver's frame buffer; AMOLED panels are often narrower than the controller."
        },
        "y_offset": {
          "type": "integer"
        },
        "qspi": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sclk": {
              "type": "integer"
            },
            "cs": {
              "type": "integer"
            },
            "d0": {
              "type": "integer"
            },
            "d1": {
              "type": "integer"
            },
            "d2": {
              "type": "integer"
            },
            "d3": {
              "type": "integer"
            }
          }
        },
        "reset": {
          "type": "integer"
        },
        "te": {
          "type": "integer",
          "description": "Tearing-effect sync line, -1 when unused."
        },
        "touch": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "chip": {
              "type": "string"
            },
            "i2c_address": {
              "type": "integer"
            },
            "sda": {
              "type": "integer"
            },
            "scl": {
              "type": "integer"
            },
            "interrupt": {
              "type": "integer"
            },
            "reset": {
              "type": "integer"
            }
          }
        },
        "rotation": {
          "type": "integer",
          "enum": [
            0,
            90,
            180,
            270
          ],
          "description": "Degrees to rotate the UI so it is upright in use. A panel is soldered in whatever orientation the mechanical design wanted; this is where that fact lives."
        },
        "backlight": {
          "type": "integer",
          "description": "PWM backlight GPIO. AMOLED panels set brightness with a command and have none; a transmissive LCD needs the pin."
        },
        "expander": {
          "type": "object",
          "additionalProperties": false,
          "description": "Some panel control lines live on an I2C I/O expander rather than a chip GPIO. Where they do, `reset` and `backlight` above are -1 and the pin is named here instead \u2014 the distinction matters because an expander line costs an I2C transaction and cannot be driven from an ISR.",
          "properties": {
            "chip": {
              "type": "string"
            },
            "i2c_address": {
              "type": "integer"
            },
            "interrupt": {
              "type": "integer",
              "description": "Expander's own INT line, when wired."
            },
            "reset_pin": {
              "type": "integer",
              "description": "Expander pin carrying panel reset."
            },
            "backlight_enable_pin": {
              "type": "integer"
            }
          }
        }
      }
    }
  }
}
