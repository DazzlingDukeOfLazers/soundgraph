[configuration]

entry_symbol = "soundgraph_library_init"
compatibility_minimum = "4.4"
reloadable = true

[libraries]

; Godot 4.2+ feature tags. The editor itself matches "editor"; exported builds match one
; of the "template_" tags. The older "debug"/"release" spellings are not looked up here,
; so a library listed only under those is silently never loaded.
windows.editor.x86_64 = "res://bin/soundgraph_godot.dll"
windows.template_debug.x86_64 = "res://bin/soundgraph_godot.dll"
windows.template_release.x86_64 = "res://bin/soundgraph_godot.dll"

macos.editor = "res://bin/libsoundgraph_godot.dylib"
macos.template_debug = "res://bin/libsoundgraph_godot.dylib"
macos.template_release = "res://bin/libsoundgraph_godot.dylib"

linux.editor.x86_64 = "res://bin/libsoundgraph_godot.so"
linux.template_debug.x86_64 = "res://bin/libsoundgraph_godot.so"
linux.template_release.x86_64 = "res://bin/libsoundgraph_godot.so"

; Web. The extension is an Emscripten SIDE_MODULE, and the export must use one of the
; "dlink" templates or the engine has no dynamic loader to give it. The nothreads variant
; is deliberate: threaded web exports need SharedArrayBuffer, which needs cross-origin
; isolation headers, which a plain static host does not send — and a zero-install URL that
; only works behind special headers is not zero-install.
; Only the release entries: the web library is built against godot-cpp's template_release,
; so pointing a debug export at the same file would be a quiet mismatch. A debug export
; will fail to find a library, which says what is wrong; a mismatched one would not.
web.release.wasm32.nothreads = "res://bin/soundgraph_godot.web.wasm32.nothreads.wasm"
web.release.wasm32 = "res://bin/soundgraph_godot.web.wasm32.nothreads.wasm"
