; SoundGraph — Godot editor
;
; The primary editor. It is a frontend: every question about what a graph means is
; answered by the SoundGraphEngine extension, which wraps the same dsp-core the browser
; and the command line tools use.

config_version=5

[application]

config/name="SoundGraph Editor"
config/description="Visual editor for SoundGraph patches. The graph is the product; this is one way to look at it."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
; canvas_items keeps the UI at a readable scale on any display — 1440x900 is the size the
; type and hit targets were chosen for, and everything is scaled from it rather than
; rendered in raw pixels that shrink as the screen grows.
;
; "expand" is the half that was missing. The default aspect is "keep", which fits that
; 1440x900 box inside the window and puts bars round it: a bigger browser gave bigger
; pixels and not one more module. With "expand" the scale is held and the viewport grows
; into whatever space there is, so a wide window means a wider rack.
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

; Named, so the rack asks for the command and not for a key.
;
; Alt is provisional and platform-shaped: on macOS it is Option, which composes characters
; and is claimed by parts of the window manager, and on Linux it drives menu mnemonics. A
; rack that knew the key would have to be edited to change it, and would have to know the
; platform to be right on more than one.
ghost_cables={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194328,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[audio]

driver/output_latency=15
