{
  "schema_version": 1,
  "metadata": {
    "name": "Golden: delay",
    "description": "Seeded noise through a delay with internal feedback.",
    "tags": [
      "golden"
    ]
  },
  "nodes": [
    {
      "id": "noise",
      "type": "Noise",
      "parameters": {
        "seed": 777
      }
    },
    {
      "id": "gate",
      "type": "Gain",
      "parameters": {
        "gain": 0.4
      }
    },
    {
      "id": "delay",
      "type": "Delay",
      "parameters": {
        "time": 0.05,
        "feedback": 0.6,
        "mix": 0.5
      }
    },
    {
      "id": "out",
      "type": "StereoOutput",
      "parameters": {
        "level": 0.8,
        "safety_limit": 0
      }
    }
  ],
  "connections": [
    {
      "from": {
        "node": "noise",
        "port": "out"
      },
      "to": {
        "node": "gate",
        "port": "in"
      }
    },
    {
      "from": {
        "node": "gate",
        "port": "out"
      },
      "to": {
        "node": "delay",
        "port": "in"
      }
    },
    {
      "from": {
        "node": "delay",
        "port": "out"
      },
      "to": {
        "node": "out",
        "port": "left"
      }
    }
  ]
}
