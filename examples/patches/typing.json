{
  "schema_version": 1,
  "metadata": {
    "name": "Typing",
    "description": "A keyboard. Filtered noise for the thock, a square blip for the switch and a high tick for the cap, with the noise band moving on every key so no two are the same. One keystroke to a note."
  },
  "nodes": [
    {
      "id": "kb",
      "type": "NoteInput"
    },
    {
      "id": "vary",
      "type": "LFO",
      "parameters": {
        "rate": 37.0,
        "shape": 4,
        "amount": 1.0
      }
    },
    {
      "id": "hold",
      "type": "SampleHold"
    },
    {
      "id": "spread",
      "type": "Multiply",
      "parameters": {
        "factor": 700.0
      }
    },
    {
      "id": "centre",
      "type": "Add",
      "parameters": {
        "offset": 1900.0
      }
    },
    {
      "id": "hiss",
      "type": "Noise",
      "parameters": {
        "colour": 0.0
      }
    },
    {
      "id": "body",
      "type": "StateVariableFilter",
      "parameters": {
        "mode": 2,
        "resonance": 0.5
      }
    },
    {
      "id": "thock",
      "type": "AhdEnvelope",
      "parameters": {
        "attack": 0.0,
        "hold": 0.003,
        "decay": 0.028
      }
    },
    {
      "id": "thock_amp",
      "type": "Gain"
    },
    {
      "id": "switch",
      "type": "SquareOscillator",
      "parameters": {
        "frequency": 540.0,
        "pulse_width": 0.22
      }
    },
    {
      "id": "click",
      "type": "AhdEnvelope",
      "parameters": {
        "attack": 0.0,
        "hold": 0.001,
        "decay": 0.009
      }
    },
    {
      "id": "click_amp",
      "type": "Gain"
    },
    {
      "id": "cap",
      "type": "Noise",
      "parameters": {
        "colour": 0.0
      }
    },
    {
      "id": "bright",
      "type": "StateVariableFilter",
      "parameters": {
        "mode": 1,
        "cutoff": 5200.0,
        "resonance": 0.2
      }
    },
    {
      "id": "tick",
      "type": "AhdEnvelope",
      "parameters": {
        "attack": 0.0,
        "hold": 0.0005,
        "decay": 0.005
      }
    },
    {
      "id": "tick_amp",
      "type": "Gain"
    },
    {
      "id": "mix",
      "type": "Mixer",
      "parameters": {
        "level1": 1.0,
        "level2": 0.3,
        "level3": 0.5
      }
    },
    {
      "id": "out",
      "type": "StereoOutput",
      "parameters": {
        "level": 0.9
      }
    }
  ],
