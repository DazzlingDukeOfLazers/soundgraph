{
  "schema_version": 1,
  "metadata": {
    "name": "R2-D2",
    "description": "A droid, played. Hold a key and he chatters in that register: swooping tones with a metallic edge, sine pairs in phase modulation, bent up on the beats and down on the offbeats."
  },
  "nodes": [
    {
      "id": "kb",
      "type": "NoteInput"
    },
    {
      "id": "pulse",
      "type": "Retrigger",
      "parameters": {
        "rate": 5.0,
        "width": 2.0
      }
    },
    {
      "id": "asking",
      "type": "Euclid",
      "parameters": {
        "steps": 8,
        "fill": 3,
        "rotate": 0
      }
    },
    {
      "id": "answering",
      "type": "Euclid",
      "parameters": {
        "steps": 8,
        "fill": 2,
        "rotate": 3
      }
    },
    {
      "id": "where_rand",
      "type": "LFO",
      "parameters": {
        "rate": 29.0,
        "shape": 4,
        "amount": 1.0
      }
    },
    {
      "id": "where_hold",
      "type": "SampleHold"
    },
    {
      "id": "where_scale",
      "type": "Multiply",
      "parameters": {
        "factor": 700.0
      }
    },
    {
      "id": "where_centre",
      "type": "Add",
      "parameters": {
        "offset": 0.0
      }
    },
    {
      "id": "up",
      "type": "Slide",
      "parameters": {
        "slide": 900.0,
        "limit": 3600.0
      }
    },
    {
      "id": "down",
      "type": "Slide",
      "parameters": {
        "slide": -750.0,
        "limit": 260.0
      }
    },
    {
      "id": "both",
      "type": "Add"
    },
    {
      "id": "ratio",
      "type": "Multiply",
      "parameters": {
        "factor": 1.414
      }
    },
    {
      "id": "metal",
      "type": "SineOscillator"
    },
    {
      "id": "voice",
      "type": "SineOscillator",
      "parameters": {
        "feedback": 0.12
      }
    },
    {
      "id": "env_up",
      "type": "AhdEnvelope",
      "parameters": {
        "attack": 0.004,
        "hold": 0.05,
        "decay": 0.09
      }
    },
    {
      "id": "env_down",
      "type": "AhdEnvelope",
      "parameters": {
        "attack": 0.004,
        "hold": 0.04,
        "decay": 0.12
      }
    },
    {
      "id": "env",
      "type": "Add"
    },
    {
      "id": "amp",
      "type": "Gain"
    },
    {
      "id": "room",
      "type": "Delay",
      "parameters": {
        "time": 0.09,
        "feedback": 0.22,
        "mix": 0.16
      }
    },
    {
      "id": "out",
      "type": "StereoOutput",
      "parameters": {
        "level": 0.85
      }
    },
    {
      "id": "talking_up",
      "type": "Multiply"
    },
    {
      "id": "talking_down",
      "type": "Multiply"
    }
