{
  "schema_version": 2,
  "metadata": {
    "name": "Envelope amp",
    "description": "An ADSR and a Gain as one module with a face: four shape knobs on a row, level under them. The same two nodes as the ADSR demo, wearing a panel instead of standing side by side.",
    "tags": [
      "module",
      "panel"
    ]
  },
  "modules": {
    "env_amp": {
      "description": "Envelope and amplifier. Gate it, feed it a signal, get a shaped one.",
      "nodes": [
        {
          "id": "env",
          "type": "ADSR",
          "parameters": {
            "attack": 0.01,
            "decay": 0.25,
            "sustain": 0.6,
            "release": 0.35
          }
        },
        {
          "id": "amp",
          "type": "Gain",
          "parameters": {
            "gain": 0.7
          }
        }
      ],
      "connections": [
        {
          "from": {
            "node": "env",
            "port": "out"
          },
          "to": {
            "node": "amp",
            "port": "gain"
          }
        }
      ],
      "inputs": [
        {
          "name": "gate",
          "node": "env",
          "port": "gate"
        },
        {
          "name": "in",
          "node": "amp",
          "port": "in"
        }
      ],
      "outputs": [
        {
          "name": "out",
          "node": "amp",
          "port": "out"
        }
      ],
      "parameters": [
        {
          "name": "attack",
          "node": "env",
          "parameter": "attack"
        },
        {
          "name": "decay",
          "node": "env",
          "parameter": "decay"
        },
        {
          "name": "sustain",
          "node": "env",
          "parameter": "sustain"
        },
        {
          "name": "release",
          "node": "env",
          "parameter": "release"
        },
        {
          "name": "gain",
          "node": "amp",
          "parameter": "gain"
        }
      ],
      "panel": {
        "rows": [
          [
            "attack",
            "decay",
            "sustain",
            "release"
          ],
          [
            "gain"
          ]
        ],
        "labels": {
          "gain": "Level"
        }
      }
    }
  },
  "nodes": [
    {
      "id": "kb",
      "type": "Input",
      "host": "note",
      "position": {
        "x": 0,
        "y": 200
      }
    },
    {
      "id": "osc",
      "type": "SawOscillator",
      "parameters": {
        "frequency": 220
      },
      "position": {
        "x": 560,
        "y": 200
      }
    },
    {
      "id": "voice",
      "type": "module",
      "module": "env_amp",
      "parameters": {
        "attack": 0.01,
        "decay": 0.25,
        "sustain": 0.6,
        "release": 0.35,
        "gain": 0.7
      },
      "position": {
        "x": 1120,
        "y": 200
      }
    },
    {
      "id": "out",
      "type": "Output",
      "host": "stereo",
      "parameters": {
        "level": 0.8,
        "safety_limit": 1
      },
      "position": {
        "x": 1680,
        "y": 200
      }
    }
  ],
  "connections": [
    {
      "from": {
        "node": "kb",
        "port": "frequency"
      },
      "to": {
        "node": "osc",
        "port": "frequency"
      }
    },
    {
      "from": {
        "node": "kb",
        "port": "gate"
      },
      "to": {
        "node": "voice",
        "port": "gate"
      }
    },
    {
      "from": {
        "node": "osc",
        "port": "out"
      },
      "to": {
        "node": "voice",
        "port": "in"
      }
    },
    {
      "from": {
        "node": "voice",
        "port": "out"
      },
      "to": {
        "node": "out",
        "port": "left"
      }
    },
    {
      "from": {
        "node": "voice",
        "port": "out"
      },
      "to": {
        "node": "out",
        "port": "right"
      }
    }
  ]
}
