{
  "schema_version": 2,
  "metadata": {
    "name": "Warehouse",
    "description": "A stab in a big room: the reverb is a module built from Comb and Allpass, with Size and Damp arriving as signals. Play staccato and listen to what the room does after you stop.",
    "tags": [
      "effect",
      "reverb",
      "module"
    ]
  },
