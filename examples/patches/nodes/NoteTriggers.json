{
  "schema_version": 1,
  "metadata": {
    "name": "NoteTriggers",
    "description": "Eight chromatic notes become eight triggers: the keyboard as drum pads. Try: Strike the base note for the first trigger and walk up by semitones for the rest. Notes outside the eight lanes are simply not for this node — wire each outlet to a different drum and the bottom of the keyboard is a kit. Generated by tools/node-demos.mjs. Do not edit by hand.",
    "tags": [
      "demo",
      "node"
    ]
  },
  "nodes": [
    {
      "id": "kb",
      "type": "Input",
      "host": "note",
      "position": {
        "x": 0,
        "y": 360
      }
    },
    {
      "id": "pads",
      "type": "NoteTriggers",
      "position": {
        "x": 560,
        "y": 360
      },
      "parameters": {
        "base": 60
      }
    },
    {
      "id": "tone",
      "type": "SineOscillator",
      "position": {
        "x": 560,
        "y": 0
      },
      "parameters": {
        "frequency": 220
      }
    },
    {
      "id": "env",
      "type": "AhdEnvelope",
      "position": {
        "x": 1120,
        "y": 360
      },
      "parameters": {
        "attack": 0.005,
        "hold": 0.15,
        "decay": 0.35
      }
    },
    {
      "id": "amp",
      "type": "Gain",
      "position": {
        "x": 1680,
        "y": 0
      },
      "parameters": {
        "gain": 0.7
      }
    },
    {
      "id": "out",
      "type": "Output",
      "host": "stereo",
      "position": {
        "x": 2240,
        "y": 0
      },
      "parameters": {
        "level": 0.8,
        "safety_limit": 1
      }
    }
  ],
  "connections": [
    {
      "from": {
        "node": "pads",
        "port": "t1"
      },
      "to": {
        "node": "env",
        "port": "gate"
      }
    },
    {
      "from": {
        "node": "env",
        "port": "out"
      },
      "to": {
        "node": "amp",
        "port": "gain"
      }
    },
    {
      "from": {
