{
  "schema_version": 1,
  "metadata": {
    "name": "MidiCC",
    "description": "A hardware knob as a node: one controller number off your MIDI surface, held, scaled and smoothed. Try: Plug in a controller and wiggle its first knob — the filter follows your hand. Learn (on the node) rebinds it to any knob you turn next; the sideways joystick answers to number 128. Without hardware, resting stands in for the knob. Generated by tools/node-demos.mjs. Do not edit by hand.",
    "tags": [
      "demo",
      "node"
    ]
  },
  "nodes": [
    {
      "id": "kb",
      "type": "Input",
      "host": "note",
      "position": {
        "x": 0,
        "y": 360
      }
    },
    {
      "id": "osc",
      "type": "SawOscillator",
      "position": {
        "x": 560,
        "y": 0
      },
      "parameters": {
        "frequency": 220
      }
    },
    {
      "id": "voice",
      "type": "StateVariableFilter",
      "position": {
        "x": 1120,
        "y": 0
      },
      "parameters": {
        "cutoff": 700,
        "resonance": 0.6,
        "mode": 0
      }
    },
    {
      "id": "demo",
      "type": "MidiCC",
      "position": {
        "x": 560,
        "y": 720
      },
      "parameters": {
        "cc": 1,
        "low": -1,
        "high": 3,
        "resting": 0.2,
        "glide": 15
      }
    },
    {
      "id": "env",
      "type": "AhdEnvelope",
      "position": {
        "x": 1120,
        "y": 360
      },
      "parameters": {
        "attack": 0.005,
        "hold": 0.15,
        "decay": 0.35
      }
    },
    {
      "id": "amp",
      "type": "Gain",
      "position": {
        "x": 1680,
        "y": 0
      },
      "parameters": {
        "gain": 0.7
      }
    },
    {
      "id": "out",
      "type": "Output",
      "host": "stereo",
      "position": {
        "x": 2240,
        "y": 0
      },
      "parameters": {
        "level": 0.8,
        "safety_limit": 1
      }
    }
  ],
  "connections": [
    {
      "from": {
        "node": "kb",
        "port": "frequency"
      },
      "to": {
        "node": "osc",
        "port": "frequency"
      }
    },
    {
      "from": {
        "node": "osc",
        "port": "out"
      },
      "to": {
        "node": "voice",
        "port": "in"
      }
    },
    {
      "from": {
        "node": "demo",
        "port": "out"
      },
      "to": {
        "node": "voice",
        "port": "cutoff_mod"
      }
    },
    {
      "from": {
        "node": "kb",
        "port": "trigger"
      },
