        "node": "env",
        "port": "gate"
      }
    },
    {
      "from": {
        "node": "env",
        "port": "out"
      },
      "to": {
        "node": "amp",
        "port": "gain"
      }
    },
    {
      "from": {
        "node": "voice",
        "port": "out"
      },
      "to": {
        "node": "amp",
        "port": "in"
      }
    },
    {
      "from": {
        "node": "amp",
        "port": "out"
      },
