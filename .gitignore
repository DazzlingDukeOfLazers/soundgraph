build/
build-*/
out/

# Built by the WebAssembly configuration and copied in for local serving.
editor-web/soundgraph.wasm
*.wav
!tests/golden/**/*.wav
!examples/audio/**/*.wav
# The sfxr reference corpus. Committed for the same reason as the golden vectors: a test
# that compares against a target regenerated on the spot is not comparing against anything.
# ~1.8 MB, and tests/sfxr/reproducible.cmake proves it can be regenerated byte-identically.
!tests/sfxr/vectors/*.wav

# host tooling venv (pyserial + esptool); see embedded/README.md
.venv/

# Python bytecode. The host tools are scripts, not a package; nothing here is
# imported often enough for a cached .pyc to be worth carrying in the history.
__pycache__/
*.pyc

# editors / os
.vs/
.vscode/
.idea/
.DS_Store
Thumbs.db

# godot
editor-godot/.godot/
editor-godot/.import/
# Build output: the extension binary and the example patches mirrored in from examples/.
editor-godot/bin/
editor-godot/examples-mirror/
runtime-godot/build/
runtime-godot/third_party/godot-cpp/

# web (later)
node_modules/
editor-web/dist/
# The Godot editor exported into the lite page's directory, so the local layout
# matches production: /soundgraph and /soundgraph/editor. ~46 MB of build output,
# and its service worker's scope is confined to this subdirectory, which is the
# whole reason it lives below the page rather than beside it.
editor-web/editor/

# ESP-IDF build output; sdkconfig.defaults is the source
embedded/esp32-s3/sdkconfig
embedded/**/dependencies.lock
embedded/**/managed_components/

# Daniel's scratch layout file, kept locally
editor-godot/spacing.json

# Daniel's scratch layout files, kept locally
editor-godot/layout_example.json
editor-godot/cris-cross-arrange.json

# Godot web export output and the web build of the extension
build-godot-web/
runtime-godot/build-web/
editor-godot/.godot/

# Written at build time by tools/stamp-build.mjs. Deliberately not committed: a
# checked-in build stamp is wrong the moment anybody commits anything else, and a
# stamp that lies is worse than none — it turns "I am unsure what I am running" into
# "I am sure, and mistaken". Absent, the editor says "development build".
editor-godot/build_stamp.json
editor-web/build_stamp.json

# the editor's working directory: the status badge, in-progress patches, rescue autosaves
run/

# plugin SDKs, fetched by tools/get-plugin-sdks.sh; _fetch holds clap-wrapper's own
# pinned downloads (VST3 SDK, Apple AudioUnitSDK) so a deleted build dir does not refetch
runtime-clap/sdks/

# Reaper drops this beside whatever it considers its working directory, and a
# blanket "git add -A" swept the empty husk into a commit once already.
MIDI Programs/
